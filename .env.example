# PlayStation Network NPSSO Token
# Get this from PlayStation.com cookies (F12 > Application > Cookies > npsso)
NPSSO=your_npsso_token_here

# Allowed CORS origins for the backend API (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5173

# Backend API URL for the frontend
VITE_ALLOWED_ORIGINS=http://localhost:8080

# Full private ntfy topic URL used for application alerts. Use a long random topic name.
NTFY_TOPIC_URL=

# Secret healthchecks.io ping URL for the 15-minute service-liveness check.
HEALTHCHECKS_LIVENESS_URL=

# Secret healthchecks.io ping URL for the daily succeeded-fetch check.
HEALTHCHECKS_SUCCESS_URL=
